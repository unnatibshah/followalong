# Meta Model API key. Leave empty to run replay mode only.
MODEL_API_KEY=

# Local defaults. The hosted demo sets FA_HOSTED=true and FA_ALLOWED_ORIGIN=https://<app>.onrender.com
# in Render's dashboard.
FA_HOSTED=false
FA_PROVIDER=live
FA_VOICE=realtime
# Test only (SIT container). Never set in production or on Render.
# FA_TEST_MODE=false
# FA_CACHED_RECORDING=
# Don't set PORT here: if 8000 is taken, use PORT=8080 docker compose up.
